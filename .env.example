# Copy this file to .env and fill in your credentials (never commit .env).
# Values with special characters ({, [, *, etc.) MUST be single-quoted.

# ── kie.ai API key (required) ────────────────────────────────────────────────
# Create a key at https://kie.ai/api-key
# The key is sent as an HTTP Bearer token: `Authorization: Bearer $KIE_API_KEY`.
KIE_API_KEY='your_kie_api_key_here'

# ── Optional: kie.ai override ────────────────────────────────────────────────
# Override the base URL if kie.ai provides a different host for your workspace.
# KIE_BASE_URL=https://api.kie.ai

# ── Supabase Storage (optional — for hosting reference images/audio) ─────────
# kie.ai requires public HTTPS URLs for every reference. Supabase is the
# repo's default host via scripts/upload-to-supabase.sh.
#
# Setup (one time):
#   1. Create a Supabase project at https://supabase.com/dashboard (or use an existing one)
#   2. Storage → New bucket → name: claude-marketing-agent-assets → set Public: ON
#   3. Project Settings → API → copy:
#      - Project URL (e.g. https://abcdefgh.supabase.co) → SUPABASE_URL below
#      - service_role key (under "Project API keys") → SUPABASE_SERVICE_ROLE_KEY below
#        ⚠  service_role bypasses RLS. Keep it in .env only. Never commit, never share.
#   4. Paste values below, then test with: ./scripts/upload-to-supabase.sh references/audio/foo.mp3
SUPABASE_URL='https://your-project-ref.supabase.co'
SUPABASE_SERVICE_ROLE_KEY='your_service_role_key_here'
SUPABASE_BUCKET='claude-marketing-agent-assets'
